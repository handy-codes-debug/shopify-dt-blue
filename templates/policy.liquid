{% comment %}
  Store policy pages (refund, shipping, privacy, terms of service,
  subscription). Policy pages support a Liquid template only, and expose the
  content through the `page_title` / `page_content` variables. Body styling
  is shared with Shopify's default markup in critical.css.
{% endcomment %}

{% # theme-check-disable UndefinedObject %}
<div class="policy-page">
  <div class="policy-page__inner">
    <h1 class="policy-page__title">{{ page_title }}</h1>
    <div class="policy-page__body rte">
      {{ page_content }}
    </div>
  </div>
</div>
{% # theme-check-enable UndefinedObject %}

<style>
  .policy-page {
    padding-top: clamp(56px, 9vw, 128px);
    padding-bottom: clamp(40px, 7vw, 80px);
    padding-inline: clamp(20px, 5vw, 48px);
  }
  .policy-page__inner {
    max-width: 820px;
    margin-inline: auto;
  }
  .policy-page__title {
    margin: 0 0 14px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-border);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }
  .policy-page__body {
    color: var(--color-foreground-soft);
  }
</style>
