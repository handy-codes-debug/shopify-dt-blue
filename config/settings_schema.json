        "default": true
      },
      {
        "type": "color",
        "id": "dark_photo_backdrop_color",
        "default": "#B4B7BF",
        "label": "t:labels.dark_photo_backdrop",
        "info": "t:info.dark_photo_backdrop"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.product_card",
    "settings": [
      {
        "type": "header",
        "content": "t:labels.card_subtitle_source",
        "info": "t:info.card_subtitle_source"
      },
      {
        "type": "checkbox",
        "id": "card_show_tags",
        "label": "t:options.card_subtitle_source.tags",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_metafield_1",
        "label": "t:labels.card_show_metafield_1",
        "default": false
      },
      {
        "type": "text",
        "id": "card_metafield_1",
        "label": "t:labels.card_metafield_1",
        "info": "t:info.card_subtitle_metafield",
        "placeholder": "custom.material"
      },
      {
        "type": "checkbox",
        "id": "card_show_metafield_2",
        "label": "t:labels.card_show_metafield_2",
        "default": false
      },
      {
        "type": "text",
        "id": "card_metafield_2",
        "label": "t:labels.card_metafield_2",
        "info": "t:info.card_subtitle_metafield",
        "placeholder": "custom.manufacturer_part_number"
      },
      {
        "type": "range",
        "id": "badge_size",
        "min": 70,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:labels.badge_size",
        "info": "t:info.badge_size",
        "default": 100
      },
      {
        "type": "range",
        "id": "card_image_size",
        "min": 70,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:labels.card_image_size",
        "info": "t:info.card_image_size",
        "default": 100
      }
    ]
