{% doc %}
  Renders a product card: media with badge, vendor, title, spec chips, price and an add-to-cart action.

  @param {object} product - The product to render.
  @param {number} [low_stock_threshold] - Inventory at or below this shows a "low stock" state. Default 5.
  @param {boolean} [show_vendor] - Show the product vendor above the title. Default true.
{% enddoc %}

{% liquid
  assign threshold = low_stock_threshold | default: 5
  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  assign discount_percent = 0
  if product.compare_at_price > product.price
    assign on_sale = true
    assign discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif

  assign is_new = false
  assign created_ts = product.created_at | date: '%s' | plus: 0
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign age = now_ts | minus: created_ts
  if age < 2592000
    assign is_new = true
  endif

  assign low_stock = false
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= threshold
    assign low_stock = true
  endif

  assign show_card_tags = settings.card_show_tags
  assign card_mf1_value = blank
  if settings.card_show_metafield_1 and settings.card_metafield_1 != blank
    assign card_mf1_path = settings.card_metafield_1 | split: '.'
    assign card_mf1_value = product.metafields[card_mf1_path[0]][card_mf1_path[1]].value
  endif
  assign card_mf2_value = blank
  if settings.card_show_metafield_2 and settings.card_metafield_2 != blank
    assign card_mf2_path = settings.card_metafield_2 | split: '.'
    assign card_mf2_value = product.metafields[card_mf2_path[0]][card_mf2_path[1]].value
  endif

  assign has_card_subtitle = false
  if show_card_tags and product.tags.size > 0
    assign has_card_subtitle = true
  endif
  if card_mf1_value != blank or card_mf2_value != blank
    assign has_card_subtitle = true
  endif
%}

<div class="pcard">
  <a class="pcard__media" href="{{ product.url }}">
    {%- if product.featured_image -%}
      {%- assign card_alt = product.featured_image.alt | default: product.title -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,400,600', sizes: '(max-width: 700px) 45vw, 260px', alt: card_alt }}
    {%- else -%}
      <span class="pcard__placeholder">{{ product.title | slice: 0, 2 | upcase }}</span>
    {%- endif -%}

    {%- if product.available == false -%}
      {%- comment -%} no badge, sold-out pill shown below {%- endcomment -%}
    {%- elsif on_sale -%}
      <span class="badge badge--sale">{{ 'products.sale_percent' | t: percent: discount_percent }}</span>
    {%- elsif low_stock -%}
      <span class="badge badge--low">{{ 'products.low_stock' | t }}</span>
    {%- elsif is_new -%}
      <span class="badge badge--new">{{ 'products.new' | t }}</span>
    {%- endif -%}
  </a>

  <div class="pcard__body">
    {%- if show_vendor != false and product.vendor != blank -%}
      <span class="pcard__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <a class="pcard__title" href="{{ product.url }}">{{ product.title }}</a>

    {%- if has_card_subtitle -%}
      <div class="pcard__specs">
        {%- if show_card_tags -%}
          {%- for tag in product.tags limit: 2 -%}
            {%- unless tag contains ':' -%}<span class="chip">{{ tag }}</span>{%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if card_mf1_value != blank -%}<span class="chip">{{ card_mf1_value }}</span>{%- endif -%}
        {%- if card_mf2_value != blank -%}<span class="chip">{{ card_mf2_value }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="pcard__footer">
      <div class="pcard__price">
        {% render 'price', product: product, show_from: true %}
      </div>

      {%- if product.available -%}
        {%- form 'product', product, class: 'pcard__form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit" class="btn btn--dark btn--sm">{{ 'products.add_to_cart' | t }}</button>
        {%- endform -%}
      {%- else -%}
        <span class="stock-pill stock-pill--out">{{ 'products.sold_out' | t }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pcard {
    display: flex;
    flex-direction: column;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-lg);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .pcard:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--style-shadow-lg);
    transform: translateY(-3px);
  }
  .pcard__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background: #FFFFFF;
    overflow: hidden;
    padding: calc(30px * var(--card-scale, 1));
  }
  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.25s ease;
  }
  .pcard:hover .pcard__media img {
    transform: scale(1.06);
  }
  .pcard__placeholder {
    font-family: var(--font-accent--family);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--color-foreground-faint);
  }
  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: calc(8px * var(--card-scale, 1));
    padding: calc(14px * var(--card-scale, 1)) calc(16px * var(--card-scale, 1)) calc(16px * var(--card-scale, 1));
    flex: 1;
  }
  .pcard__vendor {
    font-size: calc(0.7rem * var(--card-scale, 1));
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground-faint);
  }
  .pcard__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
    font-weight: 600;
    font-size: calc(0.92rem * var(--card-scale, 1));
    line-height: 1.3;
    color: var(--color-foreground);
  }
  .pcard__title:hover {
    color: var(--color-accent);
  }
  .pcard__price {
    font-size: calc(1rem * var(--card-scale, 1));
  }
  .pcard__specs {
    display: flex;
    flex-wrap: wrap;
    gap: calc(6px * var(--card-scale, 1));
  }
  .pcard__specs .chip {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: calc(0.72rem * var(--card-scale, 1));
    padding: calc(3px * var(--card-scale, 1)) calc(8px * var(--card-scale, 1));
  }
  .pcard__footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: calc(8px * var(--card-scale, 1));
    padding-top: calc(10px * var(--card-scale, 1));
    border-top: 1px solid var(--color-border);
  }
  .pcard__form {
    margin: 0;
  }
  .pcard__form .btn {
    width: 100%;
    justify-content: center;
    font-size: calc(0.8rem * var(--card-scale, 1));
    padding: calc(8px * var(--card-scale, 1)) calc(14px * var(--card-scale, 1));
  }
  .pcard__footer .stock-pill {
    width: 100%;
    justify-content: center;
    font-size: calc(0.74rem * var(--card-scale, 1));
    padding: calc(3px * var(--card-scale, 1)) calc(9px * var(--card-scale, 1));
  }
{% endstylesheet %}
