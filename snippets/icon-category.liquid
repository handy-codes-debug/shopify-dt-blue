{% doc %}
  Renders a small line icon for a category tile or nav link.

  @param {string} [name] - Icon key. When blank or "auto", the icon is guessed from `hint`.
  @param {string} [hint] - Text (usually a collection or menu title) used to pick an icon in auto mode.
  @param {boolean} [hide_if_unmatched] - In auto mode, render nothing instead of a generic fallback icon when no keyword matches.
{% enddoc %}

{%- liquid
  assign key = name | default: 'auto' | downcase
  assign matched = true

  if key == 'auto' or key == blank
    assign h = hint | downcase
    assign key = ''
    if h contains 'processor' or h contains 'cpu'
      assign key = 'processor'
    elsif h contains 'graphic' or h contains 'gpu' or h contains 'video card'
      assign key = 'gpu'
    elsif h contains 'motherboard' or h contains 'mainboard'
      assign key = 'motherboard'
    elsif h contains 'memory' or h contains 'ram'
      assign key = 'memory'
    elsif h contains 'storage' or h contains 'ssd' or h contains 'hdd' or h contains 'nvme' or h contains 'drive'
      assign key = 'storage'
    elsif h contains 'power' or h contains 'psu' or h contains 'supply'
      assign key = 'power'
    elsif h contains 'cool' or h contains 'fan' or h contains 'heat' or h contains 'air'
      assign key = 'cooling'
    elsif h contains 'desktop' or h contains 'all-in-one' or h contains 'all in one' or h contains 'mini pc' or h contains 'workstation'
      assign key = 'desktop'
    elsif h contains 'laptop' or h contains 'notebook' or h contains 'ultrabook' or h contains 'chromebook'
      assign key = 'laptop'
    elsif h contains 'case' or h contains 'chassis' or h contains 'tower'
      assign key = 'case'
    elsif h contains 'peripheral' or h contains 'mice' or h contains 'mouse'
      assign key = 'peripherals'
    elsif h contains 'keyboard'
      assign key = 'keyboard'
    elsif h contains 'monitor' or h contains 'display' or h contains 'screen'
      assign key = 'monitor'
    elsif h contains 'network' or h contains 'wifi' or h contains 'wi-fi' or h contains 'router'
      assign key = 'network'
    elsif h contains 'component'
      assign key = 'components'
    elsif h contains 'electronic'
      assign key = 'electronics'
    elsif h contains 'software' or h contains 'license' or h contains 'app'
      assign key = 'software'
    elsif h contains 'accessor'
      assign key = 'accessories'
    elsif h contains 'deal' or h contains 'sale' or h contains 'clearance' or h contains 'offer'
      assign key = 'tag'
    elsif h contains 'bundle' or h contains 'kit' or h contains 'combo' or h contains 'prebuilt'
      assign key = 'box'
    endif

    if key == ''
      assign matched = false
      assign key = 'grid'
    endif
  endif
-%}

{%- if matched or hide_if_unmatched != true -%}
  <svg class="cat-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case key -%}
      {%- when 'processor' -%}
        <rect x="7" y="7" width="10" height="10" rx="1.5"/><rect x="10" y="10" width="4" height="4" rx="0.5"/>
        <path d="M10 4v2M14 4v2M10 18v2M14 18v2M4 10h2M4 14h2M18 10h2M18 14h2"/>
      {%- when 'gpu' -%}
        <rect x="3" y="6" width="18" height="10" rx="1.5"/><circle cx="9" cy="11" r="2.5"/><path d="M15 9h3M15 13h3M6 16v3M12 16v3"/>
      {%- when 'motherboard' -%}
        <rect x="3.5" y="3.5" width="17" height="17" rx="1.5"/><rect x="7" y="7" width="5" height="5" rx="0.5"/><path d="M15 7h3M15 10h3M7 15h11M7 18h7"/>
      {%- when 'memory' -%}
        <rect x="3" y="7" width="18" height="9" rx="1"/><path d="M7 16v2M11 16v2M15 16v2M7 10v3M10 10v3M13 10v3M16 10v3"/>
      {%- when 'storage' -%}
        <rect x="3.5" y="5" width="17" height="14" rx="1.5"/><circle cx="12" cy="12" r="3.5"/><circle cx="12" cy="12" r="0.6" fill="currentColor"/>
      {%- when 'power' -%}
        <path d="M12 3v9"/><path d="M6.5 7.5a8 8 0 1 0 11 0"/>
      {%- when 'cooling' -%}
        <circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/>
        <path d="M12 4c2 2.2 2 4.6 0 6.4M20 12c-2.2 2-4.6 2-6.4 0M12 20c-2-2.2-2-4.6 0-6.4M4 12c2.2-2 4.6-2 6.4 0"/>
      {%- when 'case' -%}
        <rect x="6" y="3" width="12" height="18" rx="1.5"/><path d="M9 6h6M9 9h6"/><circle cx="12" cy="15.5" r="1.2"/>
      {%- when 'laptop' -%}
        <rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19.5h20l-2-3.5H4z"/>
      {%- when 'desktop' -%}
        <rect x="4" y="7" width="16" height="10" rx="1.5"/><path d="M7 21h10M12 17v4"/><circle cx="8" cy="12" r="1.1" fill="currentColor" stroke="none"/><path d="M12 12h4"/>
      {%- when 'keyboard' -%}
        <rect x="3" y="7" width="18" height="10" rx="1.5"/><path d="M7 10h.01M11 10h.01M15 10h.01M17 10h.01M7 13h10"/>
      {%- when 'peripherals' -%}
        <rect x="2" y="8" width="11" height="8" rx="1.5"/><path d="M5 11h.01M8 11h.01M5 13.5h4"/>
        <rect x="16" y="4" width="6" height="11" rx="3"/><path d="M19 4v3"/>
      {%- when 'monitor' -%}
        <rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M9 20h6M12 16v4"/>
      {%- when 'network' -%}
        <rect x="8" y="14" width="8" height="6" rx="1"/><path d="M12 14v-3M6 11h12M6 11V8M18 11V8M9 8V5h6v3"/>
      {%- when 'components' -%}
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 3v3.5a2 2 0 0 0 2 2h4M8 21v-3.5a2 2 0 0 1 2-2h4"/>
        <circle cx="16" cy="8.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="16" cy="15.5" r="1.3" fill="currentColor" stroke="none"/>
      {%- when 'accessories' -%}
        <path d="M9 2v6M15 2v6"/><path d="M6 8h12v4a6 6 0 0 1-12 0z"/><path d="M12 18v4"/>
      {%- when 'electronics' -%}
        <path d="M13 2 4 14h6l-1 8 9-12h-6z"/>
      {%- when 'software' -%}
        <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8.5h18"/>
        <circle cx="6" cy="6.25" r="0.6" fill="currentColor" stroke="none"/><circle cx="8.5" cy="6.25" r="0.6" fill="currentColor" stroke="none"/>
      {%- when 'tag' -%}
        <path d="M4 12.5V5a1 1 0 0 1 1-1h7.5L20 11.5a1.5 1.5 0 0 1 0 2L14 20a1.5 1.5 0 0 1-2 0z"/><circle cx="8.5" cy="8.5" r="1.2"/>
      {%- when 'box' -%}
        <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 21V12M12 12l8-4.5M12 12L4 7.5"/>
      {%- else -%}
        <rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
