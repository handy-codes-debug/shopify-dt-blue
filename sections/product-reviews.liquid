{% comment %}
  Product reviews: a rating summary from the reviews.rating /
  reviews.rating_count metafields plus an @app block slot for a review app
  (Judge.me, Loox, Shopify Product Reviews, etc.). Reads the template's `product`.
{% endcomment %}

{% liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign spr_reviews = product.metafields.spr.reviews
  assign has_app = false
  if section.blocks.size > 0
    assign has_app = true
  endif
%}

<section
  class="section-pad{% if section.settings.tinted %} surface-alt full-width{% endif %}"
  id="reviews"
>
  <div class="{% if section.settings.tinted %}page-container{% endif %} previews">
    <div class="previews__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="previews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if rating -%}
        {%- assign rounded = rating.rating | round -%}
        <div class="previews__summary">
          <span class="previews__score">{{ rating.rating }}</span>
          <div class="previews__summary-meta">
            <span class="previews__stars" aria-hidden="true">
              {%- for i in (1..5) -%}{% if i <= rounded %}★{% else %}☆{% endif %}{%- endfor -%}
            </span>
            <span class="previews__count">
              {%- if rating_count -%}
                {{ 'sections.reviews.based_on' | t: count: rating_count }}
              {%- else -%}
                {{ rating.rating }} / {{ rating.scale_max }}
              {%- endif -%}
            </span>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if has_app -%}
      <div class="previews__app">
        {% content_for 'blocks' %}
      </div>
    {%- elsif spr_reviews != blank -%}
      <div id="shopify-product-reviews" class="previews__list" data-id="{{ product.id }}">{{ spr_reviews }}</div>
    {%- elsif rating == nil -%}
      <p class="previews__empty">{{ 'sections.reviews.none' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .previews {
    max-width: 900px;
  }
  .previews__heading {
    margin: 0 0 16px;
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
  }
  .previews__summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .previews__score {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 2.4rem;
    line-height: 1;
  }
  .previews__summary-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .previews__stars {
    color: #E8A93C;
    letter-spacing: 2px;
    font-size: 1.05rem;
  }
  .previews__count {
    font-size: 0.85rem;
    color: var(--color-foreground-soft);
  }
  .previews__app,
  .previews__list {
    margin-top: 24px;
  }
  .previews__empty {
    margin-top: 16px;
    color: var(--color-foreground-soft);
  }

  /* Shopify Product Reviews app markup (product.metafields.spr.reviews) */
  .previews__list .spr-header,
  .previews__list .spr-summary {
    display: none;
  }
  .previews__list .spr-reviews {
    margin: 0;
  }
  .previews__list .spr-review {
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
  }
  .previews__list .spr-review:first-child {
    border-top: 0;
  }
  .previews__list .spr-review-header-starratings,
  .previews__list .spr-starrating,
  .previews__list .spr-icon-star {
    color: #E8A93C;
    letter-spacing: 1px;
  }
  .previews__list .spr-review-header-title {
    margin: 6px 0 2px;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .previews__list .spr-review-header-byline {
    font-size: 0.78rem;
    color: var(--color-foreground-faint);
  }
  .previews__list .spr-review-content-body {
    margin-top: 8px;
    line-height: 1.6;
    color: var(--color-foreground-soft);
  }
  .previews__list .spr-review-reportreview {
    font-size: 0.74rem;
    color: var(--color-foreground-faint);
  }
  .previews__list .spr-form {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border-strong);
  }
  .previews__list .spr-form-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .previews__list .spr-form-label {
    display: block;
    margin-bottom: 4px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground-soft);
  }
  .previews__list .spr-form-input-text,
  .previews__list .spr-form-input-email,
  .previews__list .spr-form-input-textarea {
    width: 100%;
    margin-bottom: 14px;
    padding: 10px 12px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }
  .previews__list .spr-button,
  .previews__list .spr-summary-actions-newreview {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border: 0;
    border-radius: var(--style-radius-sm);
    background: var(--color-dark-surface);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .previews__list .spr-pagination {
    margin-top: 20px;
    text-align: center;
    font-size: 0.86rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_reviews.name",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Customer reviews"
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "t:labels.tinted_background",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
