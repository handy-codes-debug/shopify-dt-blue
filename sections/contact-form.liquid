{% comment %}
  Contact page: optional intro content from the page body plus a Shopify
  contact form. Assign this section to a page via the "contact" template.
{% endcomment %}

<div class="section-pad contact">
  <header class="contact__head">
    <h1>{{ section.settings.heading | default: page.title | default: 'Contact us' }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="contact__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="contact__intro rte">{{ page.content }}</div>
    {%- endif -%}
  </header>

  {%- form 'contact', class: 'contact__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="contact__ok" role="status">{{ 'contact.success' | t }}</p>
    {%- endif -%}

    {%- if form.errors -%}
      <div class="contact__errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="contact__row">
      <label class="contact__field">
        <span>{{ 'contact.name' | t }}</span>
        <input type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
      </label>
      <label class="contact__field">
        <span>{{ 'contact.email' | t }}</span>
        <input type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
      </label>
    </div>

    <label class="contact__field">
      <span>{{ 'contact.phone' | t }}</span>
      <input type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
    </label>

    <label class="contact__field">
      <span>{{ 'contact.message' | t }}</span>
      <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
    </label>

    <button type="submit" class="btn btn--dark">{{ 'contact.submit' | t }}</button>
  {%- endform -%}
</div>

{% stylesheet %}
  .contact {
    max-width: 640px;
    margin-inline: auto;
  }
  .contact__head {
    margin-bottom: 24px;
  }
  .contact__head h1 {
    margin: 0 0 8px;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
  .contact__sub {
    margin: 0;
    color: var(--color-foreground-soft);
  }
  .contact__intro {
    margin-top: 12px;
    line-height: 1.6;
    color: var(--color-foreground-soft);
  }
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground-soft);
  }
  .contact__field input,
  .contact__field textarea {
    padding: 10px 12px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-weight: 400;
  }
  .contact__ok {
    margin: 0;
    padding: 12px 14px;
    border-radius: var(--style-radius-sm);
    background: var(--color-success-soft);
    color: var(--color-success);
    font-weight: 600;
  }
  .contact__errors {
    color: var(--color-error);
    font-size: 0.88rem;
  }

  @media (max-width: 560px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Questions about an order, a build, or business pricing? Send us a note."
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
