{% comment %}
  Contact page: two-panel layout — a Shopify contact form on the left and a
  contact-information panel on the right. Assign this section to a page via
  the "contact" template.
{% endcomment %}

{% liquid
  assign info_email = section.settings.info_email | default: shop.email
  assign info_phone = section.settings.info_phone | default: shop.phone
  assign info_address = section.settings.info_address
  if info_address == blank and shop.address
    assign info_address = shop.address.summary
  endif
%}

<div class="section-pad">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <header class="contact__head">
      {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="contact__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>
  {%- endif -%}

  <div class="contact-grid">
    <div class="contact-grid__form">
      <h2 class="contact-grid__title">{{ 'contact.form_title' | t }}</h2>

      {%- form 'contact', class: 'cform' -%}
        {%- if form.posted_successfully? -%}
          <p class="cform__ok" role="status">{{ 'contact.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="cform__errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="cform__row">
          <label class="cform__field">
            <span>{{ 'contact.name' | t }} <sup class="cform__req">*</sup></span>
            <input type="text" name="contact[name]" value="{{ form.name }}" placeholder="{{ 'contact.name_placeholder' | t }}" autocomplete="name" required>
          </label>
          <label class="cform__field">
            <span>{{ 'contact.email' | t }} <sup class="cform__req">*</sup></span>
            <input type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'contact.email_placeholder' | t }}" autocomplete="email" required>
          </label>
        </div>

        <label class="cform__field">
          <span>{{ 'contact.phone' | t }}</span>
          <input type="tel" name="contact[phone]" value="{{ form.phone }}" placeholder="{{ 'contact.phone_placeholder' | t }}" autocomplete="tel">
        </label>

        {%- if section.settings.show_order_id -%}
          <label class="cform__field">
            <span>{{ 'contact.order_id' | t }}</span>
            <input type="text" name="contact[Order ID]" placeholder="{{ 'contact.order_id_placeholder' | t }}">
          </label>
        {%- endif -%}

        <label class="cform__field">
          <span>{{ 'contact.message' | t }} <sup class="cform__req">*</sup></span>
          <textarea name="contact[body]" rows="5" placeholder="{{ 'contact.message_placeholder' | t }}" required>{{ form.body }}</textarea>
        </label>

        <div class="cform__actions">
          <button type="submit" class="btn btn--dark">{{ 'contact.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>

    <aside class="contact-grid__info">
      <h2 class="contact-grid__title contact-grid__title--light">{{ section.settings.info_heading | default: 'Contact information' }}</h2>

      {%- if info_address != blank -%}
        <div class="cinfo__row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"/><path d="M10 20v-5h4v5"/></svg>
          <span>{{ info_address | newline_to_br }}</span>
        </div>
      {%- endif -%}

      {%- if info_email != blank -%}
        <div class="cinfo__row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <a href="mailto:{{ info_email }}">{{ info_email }}</a>
        </div>
      {%- endif -%}

      {%- if info_phone != blank -%}
        <div class="cinfo__row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L21 14l1 5v.5A2.5 2.5 0 0 1 19.5 22 17.5 17.5 0 0 1 2 4.5 2.5 2.5 0 0 1 4.5 2"/></svg>
          <a href="tel:{{ info_phone | remove: ' ' }}">{{ info_phone }}</a>
        </div>
      {%- endif -%}

      {%- if section.settings.info_hours != blank -%}
        <div class="cinfo__row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <span>{{ section.settings.info_hours | newline_to_br }}</span>
        </div>
      {%- endif -%}
    </aside>
  </div>
</div>

{% stylesheet %}
  .contact__head {
    max-width: 640px;
    margin: 0 auto 24px;
    text-align: center;
  }
  .contact__head h1 {
    margin: 0 0 8px;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
  .contact__sub {
    margin: 0;
    color: var(--color-foreground-soft);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    max-width: 1040px;
    margin-inline: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-lg);
    overflow: hidden;
  }
  .contact-grid__form {
    padding: clamp(24px, 4vw, 44px);
  }
  .contact-grid__info {
    padding: clamp(24px, 4vw, 44px);
    background: var(--color-dark-surface);
    color: #fff;
  }
  .contact-grid__title {
    margin: 0 0 22px;
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .contact-grid__title--light {
    color: #fff;
  }

  .cform {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cform__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .cform__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground-soft);
  }
  .cform__req {
    color: var(--color-error);
    font-size: 0.9em;
  }
  .cform__field input,
  .cform__field textarea {
    padding: 8px 2px;
    border: 0;
    border-bottom: 1.5px solid var(--color-border-strong);
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-weight: 400;
  }
  .cform__field input::placeholder,
  .cform__field textarea::placeholder {
    color: var(--color-foreground-faint);
  }
  .cform__field input:focus,
  .cform__field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
  }
  .cform__field textarea {
    resize: vertical;
  }
  .cform__actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }
  .cform__ok {
    margin: 0;
    padding: 12px 14px;
    border-radius: var(--style-radius-sm);
    background: var(--color-success-soft);
    color: var(--color-success);
    font-weight: 600;
  }
  .cform__errors {
    color: var(--color-error);
    font-size: 0.88rem;
  }

  .cinfo__row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }
  .cinfo__row svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.6);
  }
  .cinfo__row a {
    color: #fff;
  }
  .cinfo__row a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .cform__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "checkbox",
      "id": "show_order_id",
      "label": "t:labels.show_order_id",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.info"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "t:labels.heading",
      "default": "Contact information"
    },
    {
      "type": "textarea",
      "id": "info_address",
      "label": "t:labels.address",
      "info": "t:info.contact_info_fallback"
    },
    {
      "type": "text",
      "id": "info_email",
      "label": "t:labels.email"
    },
    {
      "type": "text",
      "id": "info_phone",
      "label": "t:labels.phone"
    },
    {
      "type": "textarea",
      "id": "info_hours",
      "label": "t:labels.hours"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
