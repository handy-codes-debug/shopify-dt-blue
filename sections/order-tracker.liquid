{% comment %}
  Order tracker page: a single tracking-number field that hands off to a
  tracking service (17TRACK, AfterShip, ParcelPanel, your app's own tracking
  page, etc.). Shopify doesn't expose live shipment status directly in
  Liquid, so this redirects to a URL template you configure. Assign to a
  page via the "track-order" template.
{% endcomment %}

<div class="section-pad tracker">
  <div class="tracker__inner">
    <h1 class="tracker__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="tracker__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="tracker__intro rte">{{ page.content }}</div>
    {%- endif -%}

    <form class="tracker__form" data-tracker-form novalidate>
      <label class="visually-hidden" for="TrackingNumber">{{ section.settings.input_placeholder }}</label>
      <input
        type="text"
        id="TrackingNumber"
        placeholder="{{ section.settings.input_placeholder }}"
        autocomplete="off"
        required
      >
      <button type="submit" class="btn btn--dark">{{ section.settings.button_label }}</button>
    </form>

    <p class="tracker__error" data-tracker-error hidden>{{ 'tracker.not_configured' | t }}</p>

    <p class="tracker__help">
      {{ 'tracker.help' | t }}
      {%- if shop.customer_accounts_enabled -%}
        {{ 'tracker.help_account_html' | t: url: routes.account_url }}
      {%- endif -%}
    </p>
  </div>
</div>

<script>
  (function () {
    var form = document.querySelector('[data-tracker-form]');
    if (!form) return;
    var template = {{ section.settings.tracking_url_template | json }};
    var errorEl = document.querySelector('[data-tracker-error]');

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var value = form.querySelector('input').value.trim();
      if (!value) return;

      if (!template) {
        if (errorEl) errorEl.hidden = false;
        return;
      }
      if (errorEl) errorEl.hidden = true;
      window.location.href = template.replace('{number}', encodeURIComponent(value));
    });
  })();
</script>

{% stylesheet %}
  .tracker__inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .tracker__title {
    margin: 0 0 10px;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
  .tracker__sub {
    margin: 0 auto;
    max-width: 44ch;
    color: var(--color-foreground-soft);
  }
  .tracker__intro {
    margin-top: 14px;
    color: var(--color-foreground-soft);
    text-align: left;
  }
  .tracker__form {
    display: flex;
    gap: 10px;
    margin-top: 28px;
  }
  .tracker__form input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-size: 1rem;
  }
  .tracker__form input::placeholder {
    color: var(--color-foreground-faint);
  }
  .tracker__error {
    margin: 14px 0 0;
    padding: 10px 14px;
    border-radius: var(--style-radius-sm);
    background: var(--color-warning-soft);
    color: var(--color-warning);
    font-size: 0.86rem;
  }
  .tracker__help {
    margin: 18px 0 0;
    font-size: 0.84rem;
    color: var(--color-foreground-faint);
  }
  .tracker__help a {
    color: var(--color-accent);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 480px) {
    .tracker__form {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.order_tracker.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Order Tracker"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Enter your tracking number here to see your order status."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "t:labels.placeholder_text",
      "default": "Tracking number"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label_primary",
      "default": "Track"
    },
    {
      "type": "text",
      "id": "tracking_url_template",
      "label": "t:labels.tracking_url_template",
      "info": "t:info.tracking_url_template"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
