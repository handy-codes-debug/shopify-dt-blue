{% comment %}
  A single call-to-action banner on a rounded panel — a solid dark colour, or a
  chosen background image with a dark overlay.
{% endcomment %}

{% liquid
  assign bg_image = section.settings.background_image
  assign overlay = section.settings.overlay_opacity | default: 45 | divided_by: 100.0
%}

<div class="section-pad">
  <div class="promo{% if bg_image != blank %} promo--image{% endif %}">
    {%- if bg_image != blank -%}
      <div class="promo__bg" aria-hidden="true">
        {{
          bg_image
          | image_url: width: 2000
          | image_tag:
            widths: '600,900,1200,1600,2000',
            sizes: '(max-width: 1200px) 100vw, 1200px',
            class: 'promo__bg-img',
            loading: 'lazy',
            alt: ''
        }}
        <span class="promo__bg-overlay" style="opacity: {{ overlay }}"></span>
      </div>
    {%- endif -%}

    <div class="promo__copy">
      {%- if section.settings.heading != blank -%}<h3 class="promo__title">{{ section.settings.heading }}</h3>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="promo__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .promo {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    padding: clamp(24px, 4vw, 34px);
    border-radius: var(--style-radius-lg);
    background: var(--color-dark-surface);
    color: #fff;
  }
  .promo--image {
    background: #0B1220;
  }
  .promo__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .promo__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .promo__bg-overlay {
    position: absolute;
    inset: 0;
    background: #0B1220;
  }
  .promo__copy,
  .promo .btn {
    position: relative;
    z-index: 1;
  }
  .promo__title {
    margin: 0 0 6px;
    color: #fff;
    font-size: 1.3rem;
  }
  .promo__text {
    margin: 0;
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .promo {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.promo_banner.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Not sure what fits together?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:general.text",
      "default": "Tell us your build and we'll check socket, clearance, and power draw before it ships."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label_primary",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link_primary"
    },
    {
      "type": "header",
      "content": "t:labels.background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "info": "t:info.promo_background_image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_banner.name"
    }
  ]
}
{% endschema %}
