{% comment %}
  404 template: shown when a storefront URL cannot be found.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="section-pad notfound">
  <span class="eyebrow">{{ '404.title' | t }}</span>
  <h1 class="notfound__title">{{ '404.not_found' | t }}</h1>
  <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
</div>

{% stylesheet %}
  .notfound {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-block: clamp(48px, 10vw, 96px);
  }
  .notfound__title {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
