{% comment %}
  Policy template: renders a store policy page (refund, shipping, privacy,
  terms of service, subscription). Content comes from Settings > Policies.
{% endcomment %}

{% # theme-check-disable UndefinedObject %}
<div class="section-pad policy-page">
  <h1 class="policy-page__title">{{ page_title }}</h1>
  <div class="policy-page__body rte">
    {{ page_content }}
  </div>
</div>
{% # theme-check-enable UndefinedObject %}

{% stylesheet %}
  .policy-page {
    max-width: 760px;
    margin-inline: auto;
  }
  .policy-page__title {
    margin: 0 0 22px;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
  .policy-page__body {
    color: var(--color-foreground-soft);
  }
  .policy-page__body :is(h2, h3, h4, strong, b) {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy",
  "settings": []
}
{% endschema %}
