{% comment %}
  Policy template: renders a store policy page (refund, shipping, privacy,
  terms of service, subscription). Content comes from Settings > Policies.
{% endcomment %}

{% # theme-check-disable UndefinedObject %}
<div class="policy-page">
  <div class="policy-page__inner">
    <h1 class="policy-page__title">{{ page_title }}</h1>
    <div class="policy-page__body rte">
      {{ page_content }}
    </div>
  </div>
</div>
{% # theme-check-enable UndefinedObject %}

{% stylesheet %}
  .policy-page {
    padding-block: clamp(40px, 7vw, 76px);
  }
  .policy-page__inner {
    max-width: 820px;
    margin-inline: auto;
  }
  .policy-page__title {
    margin: 0 0 14px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-border);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }

  .policy-page__body {
    color: var(--color-foreground-soft);
  }

  /* Section headings act as dividers with generous space above them. */
  .policy-page__body h2 {
    margin-top: 2.8em;
    margin-bottom: 0.9em;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-foreground);
    font-size: 1.3rem;
  }
  .policy-page__body h2:first-child {
    margin-top: 0.4em;
  }
  .policy-page__body :is(h3, h4) {
    margin-top: 2em;
    margin-bottom: 0.5em;
    color: var(--color-foreground);
  }
  .policy-page__body :is(h3, h4):first-child {
    margin-top: 0;
  }

  .policy-page__body p {
    margin-bottom: 1.2em;
  }
  .policy-page__body :is(ul, ol) {
    margin-bottom: 1.2em;
  }
  .policy-page__body li {
    margin-bottom: 0.55em;
  }

  /* Tables get room to breathe and separate from the surrounding text. */
  .policy-page__body table {
    margin-block: 1.6em;
  }
  .policy-page__body :is(th, td) {
    padding: 13px 16px;
  }
  .policy-page__body :is(strong, b) {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy",
  "settings": []
}
{% endschema %}
