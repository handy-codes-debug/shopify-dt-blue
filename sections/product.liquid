{% comment %}
  Product template: media gallery, price, variant picker and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign low_stock_threshold = section.settings.low_stock_threshold
  assign image_ratio = section.settings.image_ratio | default: '1 / 1'

  assign variant_qty = current_variant.inventory_quantity
  assign is_low_stock = false
  if current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and variant_qty > 0 and variant_qty <= low_stock_threshold
    assign is_low_stock = true
  endif

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
%}

<div class="section-pad pdp">
  <div class="pdp__gallery" id="Gallery-{{ section.id }}">
    <div class="pdp__stage">
      {%- if product.images.size > 1 -%}
        <div class="pdp__thumbs" role="group" aria-label="{{ product.title }}">
          {%- for image in product.images limit: 12 -%}
            <button
              type="button"
              class="pdp__thumb{% if image.id == product.featured_image.id %} is-active{% endif %}"
              aria-current="{% if image.id == product.featured_image.id %}true{% else %}false{% endif %}"
              data-pdp-thumb
              data-full-src="{{ image | image_url: width: 1400 }}"
              data-zoom-src="{{ image | image_url: width: 2000 }}"
              data-alt="{{ image.alt | default: product.title | escape }}"
            >
              <img src="{{ image | image_url: width: 160 }}" loading="lazy" alt="" width="72" height="72">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if product.featured_image -%}
        {%- assign featured = product.featured_image -%}
        {%- assign main_alt = featured.alt | default: product.title -%}
        <button
          type="button"
          class="pdp__main-media"
          style="--pdp-ratio: {{ image_ratio }}"
          data-pdp-zoom
          data-zoom-src="{{ featured | image_url: width: 2000 }}"
          aria-label="{{ 'products.view_full_image' | t }}"
        >
          {{ featured | image_url: width: 1400 | image_tag: widths: '500,700,900,1100,1400', sizes: '(max-width: 900px) 92vw, 620px', fetchpriority: 'high', class: 'pdp__main-img', alt: main_alt }}
          <span class="pdp__zoom-hint" aria-hidden="true">＋</span>
        </button>
      {%- endif -%}
    </div>

    <dialog class="pdp__lightbox" data-pdp-lightbox scroll-lock>
      <button type="button" class="pdp__lightbox-close" data-pdp-lightbox-close aria-label="{{ 'products.close' | t }}">&times;</button>
      {%- comment -%} theme-check-disable ImgWidthAndHeight, RemoteAsset {%- endcomment -%}
      <img data-pdp-lightbox-img alt="" width="1200" height="900">
      {%- comment -%} theme-check-enable ImgWidthAndHeight, RemoteAsset {%- endcomment -%}
    </dialog>
  </div>

  <div class="pdp__info">
    {%- if product.vendor != blank -%}<span class="pdp__vendor">{{ product.vendor }}</span>{%- endif -%}
    <h1 class="pdp__title">{{ product.title }}</h1>

    {%- if rating -%}
      {%- assign rounded = rating.rating | round -%}
      <div class="pdp__rating">
        <span class="pdp__stars" aria-hidden="true">
          {%- for i in (1..5) -%}{% if i <= rounded %}★{% else %}☆{% endif %}{%- endfor -%}
        </span>
        <span class="pdp__rating-num">{{ rating.rating }}</span>
        {%- if rating_count -%}<span class="pdp__rating-count">({{ rating_count }})</span>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="pdp__price pdp__price--lead">
      {% render 'price', product: current_variant %}
      {%- if current_variant.available == false -%}
        <span class="stock-pill stock-pill--out">{{ 'products.sold_out' | t }}</span>
      {%- elsif is_low_stock -%}
        <span class="stock-pill stock-pill--low">{{ 'products.low_stock' | t }}</span>
      {%- else -%}
        <span class="stock-pill stock-pill--in">{{ 'products.in_stock' | t }}</span>
      {%- endif -%}
    </div>

    <dl class="pdp__facts">
      {%- if product.vendor != blank -%}
        <div><dt>{{ 'products.brand' | t }}</dt><dd>{{ product.vendor }}</dd></div>
      {%- endif -%}
      {%- if product.type != blank -%}
        <div><dt>{{ 'products.type' | t }}</dt><dd>{{ product.type }}</dd></div>
      {%- endif -%}
      {%- if current_variant.sku != blank -%}
        <div><dt>{{ 'products.sku' | t }}</dt><dd>{{ current_variant.sku }}</dd></div>
      {%- endif -%}
      {%- unless product.has_only_default_variant -%}
        <div><dt>{{ 'products.variant' | t }}</dt><dd>{{ current_variant.title }}</dd></div>
      {%- endunless -%}
    </dl>

    {%- if product.tags.size > 0 -%}
      <div class="pdp__chips">
        {%- for tag in product.tags limit: 8 -%}
          {%- unless tag contains ':' -%}<span class="chip">{{ tag }}</span>{%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="pdp__buybox">
    <div class="pdp__price">
      {% render 'price', product: current_variant %}
    </div>

    <p class="pdp__buybox-stock">
      {%- if current_variant.available == false -%}
        <span class="pdp__dot pdp__dot--out"></span>{{ 'products.sold_out' | t }}
      {%- elsif is_low_stock -%}
        <span class="pdp__dot pdp__dot--low"></span>{{ 'products.low_stock' | t }}
      {%- else -%}
        <span class="pdp__dot pdp__dot--in"></span>{{ 'products.in_stock' | t }}
      {%- endif -%}
    </p>

    {%- form 'product', product, class: 'pdp__form' -%}
      {%- unless product.has_only_default_variant -%}
        <label class="pdp__field">
          <span>{{ 'products.variant' | t }}</span>
          <select name="id">
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected="selected"{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} &mdash; {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>
        </label>
      {%- else -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {%- endunless -%}

      <label class="pdp__field pdp__field--qty">
        <span>{{ 'products.quantity' | t }}</span>
        <input type="number" name="quantity" value="1" min="1" inputmode="numeric">
      </label>

      <div class="pdp__actions">
        <button type="submit" name="add" class="btn btn--dark btn--block"{% unless current_variant.available %} disabled{% endunless %}>
          {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
        {{ form | payment_button }}
      </div>
    {%- endform -%}

    <p class="pdp__buybox-meta">{{ 'products.ships_from_html' | t: shop: shop.name }}</p>
  </div>
</div>

<script>
  (function () {
    var gallery = document.getElementById('Gallery-{{ section.id }}');
    if (!gallery) return;

    var mainBtn = gallery.querySelector('[data-pdp-zoom]');
    var mainImg = mainBtn ? mainBtn.querySelector('img') : null;
    var thumbs = gallery.querySelectorAll('[data-pdp-thumb]');
    var lightbox = gallery.querySelector('[data-pdp-lightbox]');
    var lightboxImg = lightbox ? lightbox.querySelector('img') : null;
    var lightboxClose = gallery.querySelector('[data-pdp-lightbox-close]');

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (!mainImg) return;
        mainImg.setAttribute('src', thumb.getAttribute('data-full-src'));
        mainImg.removeAttribute('srcset');
        mainImg.setAttribute('alt', thumb.getAttribute('data-alt') || '');
        if (mainBtn) mainBtn.setAttribute('data-zoom-src', thumb.getAttribute('data-zoom-src'));

        thumbs.forEach(function (t) {
          t.classList.toggle('is-active', t === thumb);
          t.setAttribute('aria-current', t === thumb ? 'true' : 'false');
        });
      });
    });

    function openLightbox() {
      if (!lightbox || !lightboxImg || !mainBtn) return;
      lightboxImg.setAttribute('src', mainBtn.getAttribute('data-zoom-src') || (mainImg && mainImg.currentSrc) || '');
      lightboxImg.setAttribute('alt', (mainImg && mainImg.getAttribute('alt')) || '');
      if (typeof lightbox.showModal === 'function') {
        lightbox.showModal();
      } else {
        lightbox.setAttribute('open', '');
      }
    }

    function closeLightbox() {
      if (!lightbox) return;
      if (typeof lightbox.close === 'function') {
        lightbox.close();
      } else {
        lightbox.removeAttribute('open');
      }
    }

    if (mainBtn) mainBtn.addEventListener('click', openLightbox);
    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightbox) {
      lightbox.addEventListener('click', function (event) {
        if (event.target === lightbox) closeLightbox();
      });
    }
  })();
</script>

{% stylesheet %}
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(210px, 300px) minmax(240px, 300px);
    grid-template-areas: "gallery info buy";
    gap: 32px;
    align-items: start;
  }
  .pdp__gallery {
    grid-area: gallery;
    position: sticky;
    top: 90px;
  }
  .pdp__info {
    grid-area: info;
  }
  .pdp__buybox {
    grid-area: buy;
  }

  .pdp__stage {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .pdp__main-media {
    display: block;
    position: relative;
    flex: 1;
    min-width: 0;
    /* Fixed frame: the box keeps its size while you switch between photos. */
    aspect-ratio: var(--pdp-ratio, 1 / 1);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-lg);
    overflow: hidden;
    background: var(--color-surface-alt);
    cursor: zoom-in;
  }
  .pdp__main-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .pdp__zoom-hint {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--style-radius-pill);
    background: var(--color-dark-surface);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.85;
  }
  .pdp__main-media:hover .pdp__zoom-hint {
    opacity: 1;
  }
  .pdp__thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
  }
  .pdp__thumb {
    width: 60px;
    height: 60px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-sm);
    background: var(--color-surface-alt);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pdp__thumb:hover {
    border-color: var(--color-border-strong);
  }
  .pdp__thumb.is-active {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
  .pdp__lightbox {
    /* Pin to the viewport and auto-margin so the photo sits dead centre. */
    position: fixed;
    inset: 0;
    margin: auto;
    width: fit-content;
    height: fit-content;
    max-width: min(92vw, 1100px);
    max-height: 90vh;
    padding: 0;
    border: none;
    border-radius: var(--style-radius-lg);
    background: var(--color-background);
    overflow: hidden;
  }
  .pdp__lightbox:not([open]) {
    display: none;
  }
  .pdp__lightbox::backdrop {
    background: rgba(11, 18, 32, 0.72);
  }
  .pdp__lightbox img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 90vh;
    object-fit: contain;
  }
  .pdp__lightbox-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: var(--style-radius-pill);
    background: var(--color-dark-surface);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .pdp__vendor {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground-faint);
  }
  .pdp__title {
    margin: 4px 0 10px;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
  }
  .pdp__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: var(--color-foreground-soft);
  }
  .pdp__stars {
    color: #E8A93C;
    letter-spacing: 1px;
  }
  .pdp__rating-count {
    color: var(--color-accent);
  }
  .pdp__price {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pdp__price--lead {
    margin: 12px 0;
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
  }
  .pdp__price--lead .price {
    font-size: 1.6rem;
  }
  .pdp__facts {
    margin: 12px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pdp__facts > div {
    display: flex;
    gap: 8px;
    font-size: 0.84rem;
  }
  .pdp__facts dt {
    flex-shrink: 0;
    width: 84px;
    color: var(--color-foreground-faint);
  }
  .pdp__facts dd {
    margin: 0;
    color: var(--color-foreground);
  }
  .pdp__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .pdp__buybox {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-lg);
    background: var(--color-background);
    box-shadow: var(--style-shadow);
  }
  .pdp__buybox .price {
    font-size: 1.5rem;
  }
  .pdp__buybox-stock {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
  }
  .pdp__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--style-radius-pill);
    flex-shrink: 0;
  }
  .pdp__dot--in { background: var(--color-success); }
  .pdp__dot--low { background: var(--color-warning); }
  .pdp__dot--out { background: var(--color-error); }

  .pdp__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pdp__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground-soft);
  }
  .pdp__field select,
  .pdp__field input {
    padding: 10px 12px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-weight: 400;
  }
  .pdp__field--qty input {
    max-width: 100px;
  }
  .pdp__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pdp__actions .shopify-payment-button {
    width: 100%;
  }
  .pdp__buybox-meta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-foreground-faint);
  }

  @media (max-width: 1100px) {
    .pdp {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
      grid-template-areas:
        "gallery info"
        "gallery buy";
    }
  }
  @media (max-width: 760px) {
    .pdp {
      grid-template-columns: 1fr;
      grid-template-areas:
        "gallery"
        "info"
        "buy";
      gap: 24px;
    }
    .pdp__gallery,
    .pdp__buybox {
      position: static;
    }
    .pdp__gallery {
      max-width: 520px;
      margin-inline: auto;
    }
    .pdp__stage {
      flex-direction: column-reverse;
    }
    .pdp__thumbs {
      flex-direction: row;
      overflow-x: auto;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "1 / 1", "label": "t:options.ratio.square" },
        { "value": "4 / 3", "label": "t:options.ratio.landscape" },
        { "value": "3 / 4", "label": "t:options.ratio.portrait" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "min": 1,
      "max": 25,
      "step": 1,
      "label": "t:labels.low_stock_threshold",
      "default": 5
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
