{% comment %}
  Collection template: filter sidebar + paginated grid of product cards.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- liquid
  assign has_facets = false
  if collection.filters.size > 0 or collection.sort_options.size > 0
    assign has_facets = true
  endif
-%}

<div class="section-pad">
  <header class="coll-head">
    <span class="eyebrow">{{ 'collections.title' | t }}</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="coll-head__desc rte">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="coll-layout{% unless has_facets %} coll-layout--nofilter{% endunless %}">
      {%- if has_facets -%}
        <aside class="coll-layout__side">
          {% render 'facets', results: collection, clear_url: collection.url %}
        </aside>
      {%- endif -%}

      <div class="coll-layout__main">
        <div class="coll-toolbar">
          <span class="coll-toolbar__count">{{ 'sections.collection.count' | t: count: collection.products_count }}</span>
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="fc-grid" style="--fc-cols: {{ section.settings.columns }}">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="pagination">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {%- else -%}
          <p>{{ 'sections.collection.empty' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .coll-head__desc {
    margin-top: 10px;
    max-width: 60ch;
    color: var(--color-foreground-soft);
  }
  .coll-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 12px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.85rem;
  }
  .coll-toolbar__count {
    color: var(--color-foreground-soft);
    font-family: var(--font-accent--family);
  }
  .fc-grid {
    display: grid;
    grid-template-columns: repeat(var(--fc-cols, 4), 1fr);
    gap: 18px;
  }

  @media (max-width: 1200px) {
    .fc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .fc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_per_page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    }
  ]
}
{% endschema %}
