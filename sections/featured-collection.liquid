{% comment %}
  Shows a strip of product cards from a chosen collection.
{% endcomment %}

{% liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
%}

<div class="section-pad{% if section.settings.surface_alt %} surface-alt full-width{% endif %}">
  <div class="{% if section.settings.surface_alt %}page-container{% endif %}">
    <div class="block-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link_url | default: collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }} &rarr;</a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="fc-grid" style="--fc-cols: {{ section.settings.columns }}">
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="fc-empty">{{ 'sections.featured_collection.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .fc-grid {
    display: grid;
    grid-template-columns: repeat(var(--fc-cols, 4), 1fr);
    gap: 18px;
  }
  .fc-empty {
    color: var(--color-foreground-soft);
  }

  @media (max-width: 1000px) {
    .fc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 720px) {
    .fc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Popular right now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "See all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link_url"
    },
    {
      "type": "checkbox",
      "id": "surface_alt",
      "label": "t:labels.tinted_background",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
