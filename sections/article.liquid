{% comment %}
  Article template: full blog post with optional comments.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<article class="section-pad post">
  <header class="post__head">
    {%- assign date = article.published_at | time_tag: format: 'date' -%}
    <span class="eyebrow">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</span>
    <h1 class="post__title">{{ article.title }}</h1>
  </header>

  {%- if article.image -%}
    <div class="post__hero">
      {{ article.image | image_url: width: 1400 | image_tag: widths: '600,900,1200,1400', sizes: '(max-width: 900px) 92vw, 760px', alt: article.title, fetchpriority: 'high' }}
    </div>
  {%- endif -%}

  <div class="post__body rte">{{ article.content }}</div>

  {%- if blog.comments_enabled? -%}
    <section class="post__comments" id="comments">
      <h2>{{ 'blog.article_comments' | t }}</h2>

      {%- paginate article.comments by 20 -%}
        {%- for comment in article.comments -%}
          <div class="comment">
            <div class="comment__meta">
              <strong>{{ comment.author }}</strong>
              <span>{{ comment.created_at | time_tag: format: 'date' }}</span>
            </div>
            <p>{{ comment.content }}</p>
          </div>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          {{ paginate | default_pagination: anchor: 'comments' }}
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article, class: 'comment-form' -%}
        <h2>{{ 'blog.comment_form_title' | t }}</h2>
        {{ form.errors | default_errors }}

        <label>{{ 'blog.comment_form_name' | t }}
          <input type="text" name="comment[author]" value="{{ form.author }}" required>
        </label>
        <label>{{ 'blog.comment_form_email' | t }}
          <input type="email" name="comment[email]" value="{{ form.email }}" required>
        </label>
        <label>{{ 'blog.comment_form_body' | t }}
          <textarea name="comment[body]" rows="5" required>{{ form.body }}</textarea>
        </label>

        <button type="submit" class="btn btn--dark">{{ 'blog.comment_form_submit' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% stylesheet %}
  .post {
    max-width: 820px;
    margin-inline: auto;
  }
  .post__head {
    margin-bottom: 18px;
  }
  .post__title {
    margin: 6px 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .post__hero {
    border-radius: var(--style-radius-lg);
    overflow: hidden;
    margin-bottom: 28px;
    background: var(--color-surface-alt);
  }
  .post__hero img {
    width: 100%;
    height: auto;
  }
  .post__body {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-foreground-soft);
  }
  .post__body :is(h2, h3, h4) {
    color: var(--color-foreground);
    margin-top: 1.6em;
  }
  .post__comments {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  .comment {
    padding-block: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .comment__meta {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 0.82rem;
    color: var(--color-foreground-faint);
    margin-bottom: 6px;
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 28px;
  }
  .comment-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground-soft);
  }
  .comment-form input,
  .comment-form textarea {
    padding: 10px 12px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-weight: 400;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": []
}
{% endschema %}
