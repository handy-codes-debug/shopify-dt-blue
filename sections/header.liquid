{% comment %}
  Storefront header: utility bar, logo, product search, account + cart, and the
  primary category navigation.
{% endcomment %}

{% liquid
  assign has_utility = false
  if section.settings.utility_menu != blank and section.settings.utility_menu.links.size > 0
    assign has_utility = true
  endif
%}

<div class="site-header full-width{% if section.settings.sticky %} site-header--sticky{% endif %}">
  {%- if has_utility -%}
    <div class="util-bar">
      <div class="page-container util-bar__row">
        {%- for link in section.settings.utility_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="header-main">
    <div class="page-container header-main__row">
      {%- liquid
        assign logo_light = section.settings.logo
        assign logo_dark = section.settings.logo_dark
        assign has_dual = false
        if logo_light != blank and logo_dark != blank
          assign has_dual = true
        endif
      -%}
      <a class="site-logo{% if has_dual %} site-logo--dual{% endif %}" href="{{ routes.root_url }}">
        {%- if logo_light != blank -%}
          {{ logo_light | image_url: width: 640 | image_tag: widths: '160,320,480,640', class: 'site-logo__img site-logo__img--light', alt: shop.name }}
        {%- endif -%}
        {%- if logo_dark != blank -%}
          {{ logo_dark | image_url: width: 640 | image_tag: widths: '160,320,480,640', class: 'site-logo__img site-logo__img--dark', alt: shop.name }}
        {%- endif -%}
        {%- if logo_light == blank and logo_dark == blank -%}
          {{ shop.name }}
        {%- endif -%}
      </a>

      {%- if section.settings.show_search -%}
        <form class="header-search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'search.placeholder' | t }}"
            aria-label="{{ 'search.title' | t }}"
          >
          <button type="submit">{{ 'search.submit' | t }}</button>
        </form>
      {%- endif -%}

      <div class="header-actions">
        {%- if settings.enable_dark_mode -%}
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="{{ 'theme.toggle' | t }}" title="{{ 'theme.toggle' | t }}">
            <svg class="theme-toggle__icon theme-toggle__icon--system" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg>
            <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
            <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5z"/></svg>
          </button>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <shopify-account class="header-actions__account" menu="{{ section.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {%- endif -%}

        <a class="cart-btn" href="{{ routes.cart_url }}">
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span>{{ 'cart.title' | t }}</span>
          <span class="cart-btn__count"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
    <nav class="site-nav" aria-label="{{ section.settings.menu.title | default: 'Primary' }}">
      <ul class="page-container site-nav__row">
        {%- for link in section.settings.menu.links -%}
          {%- liquid
            assign has_children = false
            assign is_mega = false
            if link.links.size > 0
              assign has_children = true
              for child in link.links
                if child.links.size > 0
                  assign is_mega = true
                  break
                endif
              endfor
            endif
          -%}
          <li class="site-nav__item{% if has_children %} has-menu{% endif %}{% if is_mega %} site-nav__item--mega{% endif %}">
            <a
              href="{{ link.url }}"
              class="site-nav__link{% if link.current or link.child_active %} is-current{% endif %}"
              {% if link.current or link.child_active %}aria-current="page"{% endif %}
            >{{ link.title }}</a>

            {%- if has_children -%}
              <button type="button" class="site-nav__toggle" aria-expanded="false" aria-label="{{ link.title }}">
                <span aria-hidden="true">&#9662;</span>
              </button>

              {%- if is_mega -%}
                <div class="site-nav__mega">
                  <div class="page-container site-nav__mega-inner">
                    <div class="site-nav__mega-head">
                      <span class="site-nav__mega-title">{{ link.title }}</span>
                      <a class="site-nav__mega-all" href="{{ link.url }}">{{ 'header.shop_all' | t: title: link.title }} &rarr;</a>
                    </div>
                    <div class="site-nav__mega-cols">
                      {%- for child in link.links -%}
                        <div class="site-nav__mega-col">
                          <a href="{{ child.url }}" class="site-nav__mega-col-title{% if child.current %} is-current{% endif %}">{{ child.title }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul>
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}"{% if grandchild.current %} class="is-current"{% endif %}>{{ grandchild.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- else -%}
                <ul class="site-nav__dropdown">
                  {%- for child in link.links -%}
                    <li class="site-nav__subitem">
                      <a href="{{ child.url }}" class="site-nav__sublink{% if child.current %} is-current{% endif %}">{{ child.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</div>

<script>
  (function () {
    var nav = document.querySelector('.site-nav');
    if (!nav) return;
    var toggles = nav.querySelectorAll('.site-nav__toggle');

    function closeAll(except) {
      toggles.forEach(function (t) {
        if (t === except) return;
        t.setAttribute('aria-expanded', 'false');
        t.closest('.site-nav__item').classList.remove('is-open');
      });
    }

    toggles.forEach(function (toggle) {
      toggle.addEventListener('click', function () {
        var item = toggle.closest('.site-nav__item');
        var open = item.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        closeAll(open ? toggle : null);
      });
    });

    document.addEventListener('click', function (event) {
      if (!nav.contains(event.target)) closeAll(null);
    });
    nav.addEventListener('keyup', function (event) {
      if (event.key === 'Escape') closeAll(null);
    });
  })();
</script>

{%- if settings.enable_dark_mode -%}
  <script>
    (function () {
      var order = ['system', 'light', 'dark'];
      function saved() {
        try { return localStorage.getItem('theme') || 'system'; } catch (e) { return 'system'; }
      }
      function apply(mode) {
        var root = document.documentElement;
        if (mode === 'system') {
          root.removeAttribute('data-theme');
          try { localStorage.removeItem('theme'); } catch (e) {}
        } else {
          root.setAttribute('data-theme', mode);
          try { localStorage.setItem('theme', mode); } catch (e) {}
        }
      }
      var buttons = document.querySelectorAll('[data-theme-toggle]');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].addEventListener('click', function () {
          apply(order[(order.indexOf(saved()) + 1) % order.length]);
        });
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .site-header {
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header--sticky {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .util-bar {
    background: var(--color-dark-surface);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
  }
  .util-bar__row {
    display: flex;
    gap: 20px;
    padding-block: 8px;
    flex-wrap: wrap;
  }
  .util-bar a:hover {
    color: #fff;
  }

  .header-main__row {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-block: 24px;
  }
  .header-main__row .site-logo {
    font-size: 1.7rem;
  }
  .site-logo img {
    display: block;
    max-height: 58px;
    width: auto;
  }
  /* When both a light and dark logo are set, show the light one by default;
     css-variables.liquid reveals the dark one in dark mode. */
  .site-logo--dual .site-logo__img--dark {
    display: none;
  }

  .header-search {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    margin-right: 12px;
  }
  .header-search input {
    flex: 1;
    min-width: 0;
    border: 1.5px solid var(--color-border-strong);
    border-right: none;
    border-radius: var(--style-radius-sm) 0 0 var(--style-radius-sm);
    padding: 10px 14px;
    background: var(--color-surface-alt);
    color: var(--color-foreground);
    font-size: 0.92rem;
  }
  .header-search input::placeholder {
    color: var(--color-foreground-faint);
  }
  .header-search button {
    border: 1.5px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    padding: 0 18px;
    border-radius: 0 var(--style-radius-sm) var(--style-radius-sm) 0;
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
    flex-shrink: 0;
  }
  .header-actions__account svg,
  .header-actions svg {
    width: 22px;
    height: 22px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-sm);
    background: var(--color-background);
    color: var(--color-foreground-soft);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-border-strong);
  }
  .header-actions .theme-toggle svg {
    width: 18px;
    height: 18px;
  }
  .theme-toggle__icon {
    display: none;
  }
  :root:not([data-theme]) .theme-toggle__icon--system,
  :root[data-theme="system"] .theme-toggle__icon--system,
  :root[data-theme="light"] .theme-toggle__icon--light,
  :root[data-theme="dark"] .theme-toggle__icon--dark {
    display: block;
  }
  .cart-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-dark-surface);
    color: #fff;
    padding: 9px 16px;
    border-radius: var(--style-radius-sm);
    font-weight: 600;
    font-size: 0.86rem;
  }
  .cart-btn:hover {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .cart-btn svg {
    width: 18px;
    height: 18px;
  }
  .cart-btn__count {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: var(--style-radius-pill);
    font-family: var(--font-accent--family);
    font-size: 0.72rem;
    padding: 1px 7px;
  }
  .cart-btn:hover .cart-btn__count {
    background: #fff;
    color: var(--color-accent);
  }

  .site-nav {
    position: relative;
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    font-family: 'Anta', var(--font-heading--family);
    letter-spacing: 0.02em;
  }
  .site-nav__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px;
    margin: 0;
    list-style: none;
  }
  .site-nav__item {
    position: relative;
    display: flex;
    align-items: stretch;
  }
  .site-nav__item--mega {
    position: static;
  }
  .site-nav__link {
    padding: 14px 14px;
    white-space: nowrap;
    color: var(--color-foreground-soft);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    border-bottom: 3px solid transparent;
  }
  .site-nav__item.has-menu .site-nav__link {
    padding-right: 4px;
  }
  .site-nav__link:hover,
  .site-nav__link.is-current,
  .site-nav__item.is-open .site-nav__link {
    color: var(--color-foreground);
    border-bottom-color: var(--color-accent);
  }
  .site-nav__toggle {
    display: flex;
    align-items: center;
    font-family: inherit;
    padding: 0 10px 0 4px;
    border: 0;
    border-bottom: 3px solid transparent;
    background: none;
    color: var(--color-foreground-faint);
    font-size: 0.66rem;
    cursor: pointer;
  }
  .site-nav__toggle:hover,
  .site-nav__item.is-open .site-nav__toggle {
    color: var(--color-foreground);
  }
  .site-nav__toggle span {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .site-nav__item.is-open .site-nav__toggle span {
    transform: rotate(180deg);
  }

  /* ---- simple dropdown (2-level menus) ---- */
  .site-nav__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 60;
    display: none;
    min-width: 220px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-sm);
    box-shadow: var(--style-shadow-lg);
  }
  .site-nav__item:hover > .site-nav__dropdown,
  .site-nav__item:focus-within > .site-nav__dropdown,
  .site-nav__item.is-open > .site-nav__dropdown {
    display: block;
  }
  .site-nav__sublink {
    display: block;
    padding: 9px 12px;
    border-radius: var(--style-radius-sm);
    color: var(--color-foreground);
    font-size: 0.86rem;
    white-space: nowrap;
  }
  .site-nav__sublink:hover,
  .site-nav__sublink.is-current {
    background: var(--color-surface-alt);
    color: var(--color-accent);
  }

  /* ---- mega menu (3-level menus) ---- */
  .site-nav__mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 60;
    display: none;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--style-shadow-lg);
  }
  .site-nav__item--mega:hover > .site-nav__mega,
  .site-nav__item--mega:focus-within > .site-nav__mega,
  .site-nav__item--mega.is-open > .site-nav__mega {
    display: block;
  }
  .site-nav__mega-inner {
    padding-block: 28px 32px;
  }
  .site-nav__mega-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 16px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
  }
  .site-nav__mega-title {
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-foreground);
  }
  .site-nav__mega-all {
    flex-shrink: 0;
    font-family: var(--font-accent--family);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .site-nav__mega-cols {
    columns: 2 260px;
    column-gap: 48px;
    max-width: 980px;
  }
  .site-nav__mega-col {
    break-inside: avoid;
    margin-bottom: 26px;
  }
  .site-nav__mega-col-title {
    display: block;
    margin-bottom: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-foreground);
  }
  .site-nav__mega-col-title:hover,
  .site-nav__mega-col-title.is-current {
    color: var(--color-accent);
  }
  .site-nav__mega-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__mega-col li {
    margin: 0;
  }
  .site-nav__mega-col li a {
    display: block;
    padding: 6px 0;
    font-family: var(--font-primary--family);
    font-size: 0.88rem;
    color: var(--color-foreground-soft);
  }
  .site-nav__mega-col li a::before {
    content: "\203A";
    margin-right: 9px;
    color: var(--color-foreground-faint);
  }
  .site-nav__mega-col li a:hover,
  .site-nav__mega-col li a.is-current {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .header-search {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
    .header-main__row {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 700px) {
    .site-nav__row {
      flex-direction: column;
    }
    .site-nav__item {
      flex-wrap: wrap;
    }
    .site-nav__link {
      border-bottom: 0;
    }
    .site-nav__dropdown,
    .site-nav__mega {
      position: static;
      display: none;
      min-width: 0;
      margin: 0;
      padding: 0 0 8px 14px;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }
    .site-nav__item.is-open > .site-nav__dropdown,
    .site-nav__item--mega.is-open > .site-nav__mega {
      display: block;
    }
    .site-nav__item:hover > .site-nav__dropdown,
    .site-nav__item:focus-within > .site-nav__dropdown,
    .site-nav__item--mega:hover > .site-nav__mega,
    .site-nav__item--mega:focus-within > .site-nav__mega {
      display: none;
    }
    .site-nav__item.is-open:hover > .site-nav__dropdown,
    .site-nav__item.is-open:focus-within > .site-nav__dropdown,
    .site-nav__item--mega.is-open:hover > .site-nav__mega,
    .site-nav__item--mega.is-open:focus-within > .site-nav__mega {
      display: block;
    }
    .site-nav__mega-inner {
      padding: 0;
    }
    .site-nav__mega-head {
      padding-bottom: 8px;
      margin-bottom: 12px;
    }
    .site-nav__mega-cols {
      columns: auto;
      max-width: none;
    }
    .site-nav__mega-col {
      margin-bottom: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:info.logo"
    },
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "t:labels.logo_dark",
      "info": "t:info.logo_dark"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "t:labels.utility_menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:labels.sticky_header",
      "default": true
    }
  ]
}
{% endschema %}
