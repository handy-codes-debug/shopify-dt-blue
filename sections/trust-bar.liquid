{% comment %}
  A row of short trust / service promises, each with a small label tile.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <div class="trust-bar full-width surface-alt">
    <div class="page-container trust-bar__row">
      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          {%- if block.settings.abbr != blank -%}
            <span class="trust-item__tile">{{ block.settings.abbr }}</span>
          {%- endif -%}
          <div>
            <div class="trust-item__title">{{ block.settings.title }}</div>
            {%- if block.settings.text != blank -%}
              <div class="trust-item__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .trust-bar {
    border-block: 1px solid var(--color-border);
  }
  .trust-bar__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding-block: 20px;
  }
  .trust-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .trust-item__tile {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: var(--style-radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-accent--family);
    font-weight: 700;
    font-size: 0.82rem;
  }
  .trust-item__title {
    font-weight: 600;
    font-size: 0.88rem;
  }
  .trust-item__text {
    margin-top: 2px;
    color: var(--color-foreground-soft);
    font-size: 0.8rem;
  }

  @media (max-width: 800px) {
    .trust-bar__row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .trust-bar__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.trust_bar.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust_bar.block",
      "settings": [
        {
          "type": "text",
          "id": "abbr",
          "label": "t:labels.tile_label",
          "info": "t:info.tile_label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.heading",
          "default": "Free shipping over $75"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:general.text",
          "default": "Tracked, 2–4 business days"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.trust_bar.name",
      "blocks": [
        { "type": "item", "settings": { "abbr": "FS", "title": "Free shipping over $75", "text": "Tracked, 2–4 business days" } },
        { "type": "item", "settings": { "abbr": "CC", "title": "Compatibility checked", "text": "Verified before it ships" } },
        { "type": "item", "settings": { "abbr": "30", "title": "30-day returns", "text": "No restocking fee" } },
        { "type": "item", "settings": { "abbr": "B2B", "title": "Business accounts", "text": "Net terms and volume pricing" } }
      ]
    }
  ]
}
{% endschema %}
