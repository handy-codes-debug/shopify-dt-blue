{% comment %}
  A row of short trust / service promises, each with a small label tile.
{% endcomment %}

{%- liquid
  assign trust_count = section.blocks.size
  assign trust_cycle = trust_count | times: 2.4
-%}

{%- if trust_count > 0 -%}
  <div class="trust-bar full-width surface-alt">
    <div class="page-container trust-bar__row" style="--trust-cycle: {{ trust_cycle }}s">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          {%- assign trust_tag = 'a' -%}
        {%- else -%}
          {%- assign trust_tag = 'div' -%}
        {%- endif -%}
        {%- assign trust_delay = forloop.index0 | times: 1.0 | times: trust_cycle | divided_by: trust_count -%}
        <{{ trust_tag }}
          class="trust-item{% if block.settings.link != blank %} trust-item--link{% endif %}"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          style="--trust-delay: {{ trust_delay }}s"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.abbr != blank -%}
            <span class="trust-item__tile">{{ block.settings.abbr }}</span>
          {%- endif -%}
          <div>
            <div class="trust-item__title">{{ block.settings.title }}</div>
            {%- if block.settings.text != blank -%}
              <div class="trust-item__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </{{ trust_tag }}>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .trust-bar {
    border-block: 1px solid var(--color-border);
  }
  .trust-bar__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding-block: 20px;
  }
  .trust-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .trust-item--link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .trust-item--link:hover .trust-item__tile {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .trust-item--link:hover .trust-item__title {
    color: var(--color-accent);
  }
  .trust-item__tile,
  .trust-item__title {
    animation-name: trust-spotlight-tile;
    animation-duration: var(--trust-cycle, 9.6s);
    animation-delay: var(--trust-delay, 0s);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .trust-item__title {
    animation-name: trust-spotlight-title;
  }
  .trust-item:hover .trust-item__tile,
  .trust-item:hover .trust-item__title,
  .trust-item:focus-within .trust-item__tile,
  .trust-item:focus-within .trust-item__title {
    animation: none;
  }
  @keyframes trust-spotlight-tile {
    0%, 8% {
      background: var(--color-accent);
      color: var(--color-accent-contrast);
    }
    20%, 100% {
      background: var(--color-accent-soft);
      color: var(--color-accent);
    }
  }
  @keyframes trust-spotlight-title {
    0%, 8% {
      color: var(--color-accent);
    }
    20%, 100% {
      color: inherit;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trust-item__tile,
    .trust-item__title {
      animation: none;
    }
  }
  .trust-item__tile {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: var(--style-radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-accent--family);
    font-weight: 700;
    font-size: 0.82rem;
  }
  .trust-item__title {
    font-weight: 600;
    font-size: 0.88rem;
  }
  .trust-item__text {
    margin-top: 2px;
    color: var(--color-foreground-soft);
    font-size: 0.8rem;
  }

  @media (max-width: 800px) {
    .trust-bar__row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .trust-bar__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.trust_bar.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust_bar.block",
      "settings": [
        {
          "type": "text",
          "id": "abbr",
          "label": "t:labels.tile_label",
          "info": "t:info.tile_label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.heading",
          "default": "Free shipping over $75"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:general.text",
          "default": "Tracked, 2–4 business days"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link_url"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.trust_bar.name",
      "blocks": [
        { "type": "item", "settings": { "abbr": "FS", "title": "Free shipping over $75", "text": "Tracked, 2–4 business days" } },
        { "type": "item", "settings": { "abbr": "CC", "title": "Compatibility checked", "text": "Verified before it ships" } },
        { "type": "item", "settings": { "abbr": "30", "title": "30-day returns", "text": "No restocking fee" } },
        { "type": "item", "settings": { "abbr": "B2B", "title": "Business accounts", "text": "Net terms and volume pricing" } }
      ]
    }
  ]
}
{% endschema %}
