{% comment %}
  Storefront footer: brand blurb, up to several link columns, and a legal row.
{% endcomment %}

<footer class="site-footer full-width surface-dark">
  <div class="page-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="site-logo" href="{{ routes.root_url }}" style="color:#fff">{{ shop.name }}</a>
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_column' and block.settings.menu != blank -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h4>{{ block.settings.heading }}</h4>
            {%- endif -%}
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}</span>

      <span class="footer-bottom__meta">
        {%- if section.settings.disclaimer != blank -%}{{ section.settings.disclaimer }}{%- endif -%}
        {%- if section.settings.show_payment_icons -%}
          <span class="footer-payment">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'footer-payment__icon' }}
            {%- endfor -%}
          </span>
        {%- endif -%}
      </span>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding-block: 40px 22px;
    margin-top: 20px;
    font-size: 0.86rem;
  }
  .site-footer a {
    color: rgba(255, 255, 255, 0.75);
  }
  .site-footer a:hover {
    color: #fff;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-dark-surface-soft);
  }
  .footer-brand p {
    margin-top: 12px;
    max-width: 34ch;
    color: rgba(255, 255, 255, 0.7);
  }
  .footer-col h4 {
    margin-bottom: 14px;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 20px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
    flex-wrap: wrap;
  }
  .footer-bottom__meta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .footer-payment {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .footer-payment svg {
    height: 22px;
    width: auto;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "t:labels.tagline"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "t:labels.disclaimer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "t:labels.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:general.text"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
