{% comment %}
  Search template: search field, filter sidebar, and a grid of results.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{%- liquid
  assign has_facets = false
  if search.filters.size > 0
    assign has_facets = true
  endif
  assign encoded_terms = search.terms | url_encode
  assign search_clear = routes.search_url | append: '?q=' | append: encoded_terms | append: '&type=product'
-%}

<div class="section-pad search-page">
  <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <input type="hidden" name="type" value="product">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      aria-label="{{ 'search.title' | t }}"
    >
    <button type="submit" class="btn btn--primary">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="search-page__meta">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {%- else -%}
      <p class="search-page__meta">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      <div class="coll-layout{% unless has_facets %} coll-layout--nofilter{% endunless %}">
        {%- if has_facets -%}
          <aside class="coll-layout__side">
            {% render 'facets', results: search, clear_url: search_clear %}
          </aside>
        {%- endif -%}

        <div class="coll-layout__main">
          {%- paginate search.results by 24 -%}
            <div class="search-results">
              {%- for result in search.results -%}
                {%- if result.object_type == 'product' -%}
                  {% render 'product-card', product: result %}
                {%- else -%}
                  {%- assign featured_image = result.featured_image | default: result.image -%}
                  <a class="search-result" href="{{ result.url }}">
                    {%- if featured_image -%}
                      <div class="search-result__media">
                        {{ featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: result.title }}
                      </div>
                    {%- endif -%}
                    <div class="search-result__body">
                      <span class="search-result__kind">{{ result.object_type }}</span>
                      <span class="search-result__title">{{ result.title }}</span>
                    </div>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="pagination">{{ paginate | default_pagination }}</div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search-page__title {
    margin-bottom: 18px;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
  .search-page__form {
    display: flex;
    gap: 10px;
    max-width: 620px;
    margin-bottom: 18px;
  }
  .search-page__form input[type="search"] {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }
  .search-page__meta {
    margin-bottom: 20px;
    color: var(--color-foreground-soft);
  }
  .search-results {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .search-result {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--style-radius-lg);
    overflow: hidden;
  }
  .search-result:hover {
    border-color: var(--color-border-strong);
  }
  .search-result__media {
    aspect-ratio: 4 / 3;
    background: var(--color-surface-alt);
  }
  .search-result__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .search-result__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
  }
  .search-result__kind {
    font-family: var(--font-accent--family);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-faint);
  }
  .search-result__title {
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 1200px) {
    .search-results {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .search-results {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
