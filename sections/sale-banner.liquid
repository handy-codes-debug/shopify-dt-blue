{% comment %}
  Wide seasonal sale banner (Black Friday, etc.): eyebrow badge + label, a big
  display headline, a subheading, a CTA with a category breadcrumb line, and
  an optional shipping note pinned to the bottom-right corner. Each banner is
  a "slide" block; with more than one, it becomes a slideshow with arrows,
  dots, and optional autoplay. A single slide renders with no slideshow
  chrome at all.
{% endcomment %}

{%- liquid
  assign slides = section.blocks
  assign slide_count = slides.size
-%}

{%- if slide_count > 0 -%}
  <div
    class="sbanner full-width"
    id="SaleBanner-{{ section.id }}"
    data-sbanner
    {% if slide_count > 1 and section.settings.autoplay %}
      data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"
    {% endif %}
  >
    {%- for block in slides -%}
      {%- liquid
        assign bg_image = block.settings.background_image
        assign accent = block.settings.accent_color | default: '#8FB7FF'
        assign img_loading = 'lazy'
        if forloop.first
          assign img_loading = 'eager'
        endif
      -%}
      <div
        class="sbanner__slide{% if forloop.first %} is-active{% endif %}"
        style="--sbanner-accent: {{ accent }}"
        data-sbanner-slide
        {% if forloop.first %}aria-hidden="false"{% else %}aria-hidden="true"{% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="sbanner__bg" aria-hidden="true">
          {%- if bg_image != blank -%}
            {{
              bg_image
              | image_url: width: 2400
              | image_tag:
                widths: '800,1200,1600,2000,2400',
                sizes: '100vw',
                class: 'sbanner__bg-img',
                loading: img_loading,
                alt: ''
            }}
          {%- else -%}
            {%- comment -%} theme-check-disable ImgWidthAndHeight {%- endcomment -%}
            <img src="{{ 'sale-banner-circuit-bg.jpg' | asset_url }}" class="sbanner__bg-img" loading="lazy" alt="">
            {%- comment -%} theme-check-enable ImgWidthAndHeight {%- endcomment -%}
          {%- endif -%}
          <span class="sbanner__shade"></span>
        </div>

        <div class="page-container sbanner__row">
          <div class="sbanner__copy">
            {%- if block.settings.eyebrow_badge != blank or block.settings.eyebrow_label != blank -%}
              <div class="sbanner__eyebrow-row">
                {%- if block.settings.eyebrow_badge != blank -%}
                  <span class="sbanner__badge">{{ block.settings.eyebrow_badge }}</span>
                {%- endif -%}
                {%- if block.settings.eyebrow_label != blank -%}
                  <span class="sbanner__eyebrow-label">{{ block.settings.eyebrow_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h2 class="sbanner__title">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="sbanner__sub">{{ block.settings.subheading }}</p>
            {%- endif -%}

            <div class="sbanner__actions">
              {%- if block.settings.button_label != blank -%}
                <a class="sbanner__cta" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                  {{ block.settings.button_label }}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                </a>
              {%- endif -%}

              {%- if block.settings.category_list != blank -%}
                <div class="sbanner__cats">
                  {%- assign cats = block.settings.category_list | split: ',' -%}
                  {%- for cat in cats -%}
                    <span>{{ cat | strip }}</span>{%- unless forloop.last -%}<span class="sbanner__cats-sep">/</span>{%- endunless -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- if block.settings.shipping_note != blank -%}
          <div class="sbanner__ship">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="13" height="10"/><path d="M16 10h3l2 3v4h-5"/><circle cx="7" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>
            {{ block.settings.shipping_note }}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if slide_count > 1 -%}
      <button type="button" class="sbanner__arrow sbanner__arrow--prev" data-sbanner-prev aria-label="{{ 'sections.sale_banner.previous' | t }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button type="button" class="sbanner__arrow sbanner__arrow--next" data-sbanner-next aria-label="{{ 'sections.sale_banner.next' | t }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>

      <div class="sbanner__dots" role="tablist" aria-label="{{ 'sections.sale_banner.name' | t }}">
        {%- for block in slides -%}
          <button
            type="button"
            class="sbanner__dot{% if forloop.first %} is-active{% endif %}"
            data-sbanner-dot
            role="tab"
            aria-label="{{ 'sections.sale_banner.goto' | t: index: forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if slide_count > 1 -%}
  <script>
    (function () {
      var root = document.getElementById('SaleBanner-{{ section.id }}');
      if (!root) return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-sbanner-slide]'));
      var dots = Array.prototype.slice.call(root.querySelectorAll('[data-sbanner-dot]'));
      var prevBtn = root.querySelector('[data-sbanner-prev]');
      var nextBtn = root.querySelector('[data-sbanner-next]');
      var current = 0;
      var timer = null;
      var autoplayMs = parseInt(root.dataset.autoplay, 10);
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function goTo(index) {
        var next = (index + slides.length) % slides.length;
        slides[current].classList.remove('is-active');
        slides[current].setAttribute('aria-hidden', 'true');
        dots[current] && dots[current].classList.remove('is-active');
        dots[current] && dots[current].setAttribute('aria-selected', 'false');

        current = next;

        slides[current].classList.add('is-active');
        slides[current].setAttribute('aria-hidden', 'false');
        dots[current] && dots[current].classList.add('is-active');
        dots[current] && dots[current].setAttribute('aria-selected', 'true');
      }

      function start() {
        if (!autoplayMs || reduceMotion) return;
        stop();
        timer = setInterval(function () { goTo(current + 1); }, autoplayMs);
      }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
      }

      prevBtn && prevBtn.addEventListener('click', function () { goTo(current - 1); start(); });
      nextBtn && nextBtn.addEventListener('click', function () { goTo(current + 1); start(); });
      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () { goTo(i); start(); });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      start();
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .sbanner {
    position: relative;
    overflow: hidden;
    background: #06040E;
    color: #FFFFFF;
    min-height: clamp(400px, 46vw, 620px);
  }
  .sbanner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease;
  }
  .sbanner__slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }
  .sbanner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .sbanner__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  .sbanner__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 4, 14, 0.96) 0%, rgba(6, 4, 14, 0.9) 34%, rgba(6, 4, 14, 0.45) 62%, rgba(6, 4, 14, 0.1) 100%);
  }
  .sbanner__row {
    position: relative;
    z-index: 1;
    height: 100%;
    min-height: clamp(400px, 46vw, 620px);
    display: flex;
    align-items: center;
    padding-block: clamp(48px, 9vw, 96px);
  }
  .sbanner__copy {
    max-width: 46rem;
  }
  .sbanner__eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .sbanner__badge {
    display: inline-block;
    padding: 6px 13px;
    border: 1.5px solid var(--sbanner-accent);
    color: var(--sbanner-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .sbanner__eyebrow-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }
  .sbanner__title {
    margin: 0 0 20px;
    font-family: 'Big Shoulders Display', Impact, var(--font-heading--family), sans-serif;
    font-weight: 900;
    font-size: clamp(2.6rem, 8vw, 7.5rem);
    line-height: 0.85;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #FFFFFF;
  }
  .sbanner__title em {
    font-style: normal;
    color: var(--sbanner-accent);
  }
  .sbanner__sub {
    margin: 0 0 28px;
    font-size: clamp(1.05rem, 2.1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.25;
    color: #FFFFFF;
  }
  .sbanner__sub em {
    font-style: normal;
    font-weight: 700;
    color: var(--sbanner-accent);
  }
  .sbanner__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }
  .sbanner__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    background: var(--sbanner-accent);
    color: #0B1220;
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--style-radius-sm);
  }
  .sbanner__cta:hover {
    opacity: 0.88;
  }
  .sbanner__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: clamp(0.8rem, 1vw, 0.92rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.65);
  }
  .sbanner__cats-sep {
    color: rgba(255, 255, 255, 0.3);
  }
  .sbanner__ship {
    position: absolute;
    z-index: 2;
    right: 24px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 14px;
    background: rgba(6, 4, 14, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--style-radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sbanner-accent);
  }
  .sbanner__ship svg {
    flex-shrink: 0;
    color: var(--sbanner-accent);
  }

  .sbanner__arrow {
    position: absolute;
    z-index: 3;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    background: rgba(6, 4, 14, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--style-radius-pill);
    color: #FFFFFF;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .sbanner__arrow:hover {
    background: rgba(6, 4, 14, 0.8);
  }
  .sbanner__arrow--prev {
    left: 20px;
  }
  .sbanner__arrow--next {
    right: 20px;
  }

  .sbanner__dots {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    gap: 9px;
  }
  .sbanner__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .sbanner__dot.is-active {
    background: #FFFFFF;
    transform: scale(1.2);
  }

  @media (max-width: 700px) {
    .sbanner__ship {
      display: none;
    }
    .sbanner__arrow {
      width: 36px;
      height: 36px;
    }
    .sbanner__arrow--prev {
      left: 10px;
    }
    .sbanner__arrow--next {
      right: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.sale_banner.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.autoplay",
      "info": "t:info.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "t:labels.autoplay_speed",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.sale_banner.slide",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow_badge",
          "label": "t:labels.eyebrow_badge",
          "default": "Limited time"
        },
        {
          "type": "text",
          "id": "eyebrow_label",
          "label": "t:labels.eyebrow_label"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Sale"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "t:labels.subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label_primary",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:labels.button_link_primary"
        },
        {
          "type": "text",
          "id": "category_list",
          "label": "t:labels.sale_banner_categories",
          "info": "t:info.sale_banner_categories"
        },
        {
          "type": "text",
          "id": "shipping_note",
          "label": "t:labels.sale_banner_shipping_note"
        },
        {
          "type": "header",
          "content": "t:labels.background"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "t:labels.background_image",
          "info": "t:info.sale_banner_background_image"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "t:labels.accent",
          "default": "#8FB7FF"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.sale_banner.name",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
