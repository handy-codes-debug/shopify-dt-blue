{% comment %}
  Homepage hero: headline, supporting copy, up to two calls to action, and an
  optional highlighted product card. Background is the theme colour panel, or a
  chosen image with a dark overlay.
{% endcomment %}

{% liquid
  assign product = section.settings.featured_product
  assign bg_image = section.settings.background_image
  assign overlay = section.settings.overlay_opacity | default: 45 | divided_by: 100.0
%}

<div class="hero full-width surface-dark{% if bg_image != blank %} hero--image{% endif %}">
  {%- if bg_image != blank -%}
    <div class="hero__bg" aria-hidden="true">
      {{
        bg_image
        | image_url: width: 2400
        | image_tag:
          widths: '600,900,1200,1600,2000,2400',
          sizes: '100vw',
          class: 'hero__bg-img',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
      <span class="hero__bg-overlay" style="opacity: {{ overlay }}"></span>
    </div>
  {%- endif -%}

  <div class="page-container hero__row{% if section.settings.featured_product == blank %} hero__row--solo{% endif %}">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="hero__ctas">
          {%- if section.settings.button_label_1 != blank -%}
            <a class="btn btn--primary" href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label_1 }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="btn btn--ghost" href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if product != blank -%}
      <a class="hero__card" href="{{ product.url }}">
        <div class="hero__card-media">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,450,600,700', sizes: '(max-width: 900px) 90vw, 380px', alt: product.title }}
          {%- endif -%}
        </div>
        <div class="hero__card-name">{{ product.title }}</div>
        {%- if product.tags.size > 0 -%}
          <div class="hero__card-specs">
            {%- for tag in product.tags limit: 3 -%}
              {%- unless tag contains ':' -%}<span class="chip">{{ tag }}</span>{%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="hero__card-footer">
          {% render 'price', product: product %}
          {%- if product.available -%}
            <span class="stock-pill stock-pill--in">{{ 'products.in_stock' | t }}</span>
          {%- else -%}
            <span class="stock-pill stock-pill--out">{{ 'products.sold_out' | t }}</span>
          {%- endif -%}
        </div>
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-dark-surface) 0%, var(--color-dark-surface-soft) 100%);
    padding-block: clamp(36px, 6vw, 60px);
  }
  .hero--image {
    background: #0B1220;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: #0B1220;
  }
  .hero__row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  .hero__row--solo {
    grid-template-columns: 1fr;
    max-width: 42rem;
  }
  .hero__eyebrow {
    color: #8FB7FF;
  }
  .hero__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    line-height: 1.12;
    max-width: 20ch;
  }
  .hero__title em {
    font-style: normal;
    color: #8FB7FF;
  }
  .hero__sub {
    margin-top: 14px;
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .hero__card {
    display: block;
    background: var(--color-background);
    color: var(--color-foreground);
    border-radius: var(--style-radius-lg);
    padding: 22px;
    box-shadow: var(--style-shadow-lg);
  }
  .hero__card-media {
    aspect-ratio: 16 / 10;
    border-radius: var(--style-radius);
    background: linear-gradient(160deg, #1B2A4D, #0D1526);
    margin-bottom: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero__card-name {
    font-family: 'Quantico', var(--font-heading--family);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }
  .hero__card-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 14px;
  }
  .hero__card-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .hero__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "New season, new build"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Build it right the <em>first</em> time."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Compatibility-checked parts, real-time stock, and a 30-day price match on everything we carry."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "t:labels.button_label_primary",
      "default": "Shop the sale"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:labels.button_link_primary"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:labels.button_label_secondary",
      "default": "Browse all products"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:labels.button_link_secondary"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "t:labels.featured_product"
    },
    {
      "type": "header",
      "content": "t:labels.background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "info": "t:info.hero_background_image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
