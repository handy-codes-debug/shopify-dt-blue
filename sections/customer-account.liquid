{% comment %}
  Classic customer accounts: account overview with details and order history.
{% endcomment %}

<div class="section-pad account account--wide">
  <div class="account__head">
    <h1 class="account__title">{{ 'customer.account.title' | t }}</h1>
    <a class="account__back" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
  </div>

  <div class="acct-panel">
    <h2 class="acct-panel__title">{{ 'customer.account.details' | t }}</h2>
    <p class="acct-note">
      {%- if customer.name != blank -%}<strong>{{ customer.name }}</strong><br>{%- endif -%}
      {{ customer.email }}
    </p>
    <div class="acct-links">
      <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }} ({{ customer.addresses_count }})</a>
    </div>
  </div>

  <div class="acct-panel">
    <h2 class="acct-panel__title">{{ 'customer.orders.title' | t }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <div class="acct-table__scroll">
          <table class="acct-table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment_status' | t }}</th>
                <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: format: 'date' }}</td>
                  <td><span class="acct-badge acct-badge--{{ order.financial_status }}">{{ order.financial_status_label }}</span></td>
                  <td><span class="acct-badge acct-badge--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span></td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="pagination-nav">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- else -%}
        <p class="acct-empty">{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{ "name": "Customer account", "settings": [] }
{% endschema %}
