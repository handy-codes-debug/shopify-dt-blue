{% comment %}
  Classic customer accounts: single order detail.
{% endcomment %}

<div class="section-pad account account--wide">
  <div class="account__head">
    <div>
      <h1 class="account__title">{{ 'customer.order.title' | t: name: order.name }}</h1>
      <p class="acct-note">{{ order.created_at | date: format: 'date_at_time' }}</p>
    </div>
    <a class="account__back" href="{{ routes.account_url }}">&larr; {{ 'customer.order.back' | t }}</a>
  </div>

  {%- if order.cancelled -%}
    <div class="acct-errors">
      {{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | date: format: 'date' }}
      {%- if order.cancel_reason -%} — {{ order.cancel_reason_label }}{%- endif -%}
    </div>
  {%- endif -%}

  <div class="acct-panel">
    <div class="acct-table__scroll">
      <table class="acct-table">
        <thead>
          <tr>
            <th>{{ 'customer.order.product' | t }}</th>
            <th>{{ 'customer.order.price' | t }}</th>
            <th>{{ 'customer.order.quantity' | t }}</th>
            <th>{{ 'customer.order.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line in order.line_items -%}
            <tr>
              <td>
                {%- if line.product != blank -%}
                  <a href="{{ line.product.url }}">{{ line.title }}</a>
                {%- else -%}
                  {{ line.title }}
                {%- endif -%}
                {%- if line.fulfillment -%}
                  <br><span class="acct-note">{{ 'customer.order.fulfilled_on' | t: date: line.fulfillment.created_at | date: format: 'date' }}</span>
                {%- endif -%}
              </td>
              <td>{{ line.price | money }}</td>
              <td>{{ line.quantity }}</td>
              <td>{{ line.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <div class="acct-summary">
      <div class="acct-summary__row">
        <span>{{ 'customer.order.subtotal' | t }}</span>
        <span>{{ order.line_items_subtotal_price | money }}</span>
      </div>
      {%- for discount in order.cart_level_discount_applications -%}
        <div class="acct-summary__row">
          <span>{{ 'customer.order.discount' | t }} ({{ discount.title }})</span>
          <span>&minus;{{ discount.total_allocated_amount | money }}</span>
        </div>
      {%- endfor -%}
      {%- for shipping in order.shipping_methods -%}
        <div class="acct-summary__row">
          <span>{{ 'customer.order.shipping' | t }} ({{ shipping.title }})</span>
          <span>{{ shipping.price | money }}</span>
        </div>
      {%- endfor -%}
      {%- for tax in order.tax_lines -%}
        <div class="acct-summary__row">
          <span>{{ 'customer.order.tax' | t }} ({{ tax.title }} {{ tax.rate_percentage }}%)</span>
          <span>{{ tax.price | money }}</span>
        </div>
      {%- endfor -%}
      <div class="acct-summary__row acct-summary__row--total">
        <span>{{ 'customer.order.total' | t }}</span>
        <span>{{ order.total_price | money }}</span>
      </div>
    </div>
  </div>

  <div class="acct-row" style="align-items:start">
    <div class="acct-panel">
      <h2 class="acct-panel__title">{{ 'customer.order.shipping_address' | t }}</h2>
      <span class="acct-badge acct-badge--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span>
      {%- if order.shipping_address -%}
        <p class="acct-note" style="margin-top:10px">{{ order.shipping_address | format_address }}</p>
      {%- endif -%}
    </div>
    <div class="acct-panel">
      <h2 class="acct-panel__title">{{ 'customer.order.billing_address' | t }}</h2>
      <span class="acct-badge acct-badge--{{ order.financial_status }}">{{ order.financial_status_label }}</span>
      {%- if order.billing_address -%}
        <p class="acct-note" style="margin-top:10px">{{ order.billing_address | format_address }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Customer order", "settings": [] }
{% endschema %}
